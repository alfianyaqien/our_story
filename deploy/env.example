# /srv/story/shared/env
#
#   sudo install -m 600 -o story -g story deploy/env.example /srv/story/shared/env
#   sudo -u story editor /srv/story/shared/env
#
# Read by BOTH systemd (EnvironmentFile=) and deploy.sh (which sources it with
# `.` to run migrations). That dual use is why every value containing a space or
# a shell metacharacter MUST be quoted.
#
# The local .env has `EMAIL_FROM=Our Story <you@example.com>` unquoted, and it is
# a shell parse error: the `<` is read as a redirection. dotenv does not care, so
# it works in development and silently breaks the deploy script. Quote it.

# --- Database (MariaDB on this host, loopback only) --------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=story_app
DB_PASSWORD="REPLACE_WITH_DB_PASSWORD"
DB_NAME=our_story

# --- Secrets ----------------------------------------------------------------
# Generate BOTH fresh for production; do not reuse the development values.
#   openssl rand -base64 48
#
# ENCRYPTION_KEY is unrecoverable. Love letters are AES-256-GCM under a key
# derived from it, and nothing in the database dump can decrypt them without it.
# It is in the nightly backup for exactly that reason. Never change it once
# letters exist.
SESSION_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_48"
ENCRYPTION_KEY="REPLACE_WITH_OPENSSL_RAND_BASE64_48"

# --- Runtime ----------------------------------------------------------------
NODE_ENV=production
# wedding holds 3000, moment holds 3001.
PORT=3002
HOSTNAME=127.0.0.1

# Baked into verification and reset links, so it must be the public URL.
NEXT_PUBLIC_APP_URL=https://story.alfianyaqien.my.id

# Outside the release directory, so uploads survive a deploy. The app writes
# nowhere else, which is what lets story.service run ProtectSystem=strict.
UPLOAD_DIR=/srv/story/shared/uploads

# --- Email (Resend over SMTP) -----------------------------------------------
# nodemailer talks to Resend directly, so no code change is needed.
# EMAIL_USER is the literal string "resend"; EMAIL_PASS is the API key.
# The From domain must be verified in Resend or nothing is delivered.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USER=resend
EMAIL_PASS="REPLACE_WITH_RESEND_API_KEY"
EMAIL_FROM="Our Story <noreply@alfianyaqien.my.id>"
