# /etc/systemd/system/story-backup.service
# Nightly database + uploads backup. Triggered by story-backup.timer.
[Unit]
Description=Back up the Our Story database and uploads
Documentation=https://github.com/alfianyaqien/our_story/blob/main/DEPLOYMENT.md

[Service]
Type=oneshot
User=story
Group=story
ExecStart=/srv/story/bin/backup.sh

# Writes the local backup set here.
# /srv/story/.config is writable because rclone REWRITES rclone.conf whenever it
# refreshes the OAuth access token. Under ProtectSystem=strict without this, the
# refresh fails and the offsite push starts erroring roughly an hour after the
# token was last minted - long after any setup test would have passed.
ReadWritePaths=/var/backups/story /srv/story/shared /srv/story/.config
ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true
# NOT ProtectHome: rclone reads its token from ~story/.config/rclone/rclone.conf,
# and hiding it here is what makes the offsite push silently do nothing.
